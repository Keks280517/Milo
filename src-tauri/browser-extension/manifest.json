{
  "manifest_version": 3,
  "name": "Milo für den Browser",
  "version": "1.1.0",
  "description": "Lässt Milo Seiten lesen, Titel finden und anklicken. Spricht nur mit Milo auf deinem PC, nie mit dem Internet.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "minimum_chrome_version": "110"
}
